# ===================================
# Firebase Authentication & API設定
# ===================================
# Firebase Console > プロジェクト設定 > アプリ から取得（公開前提の値）
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ===================================
# Backend Server 設定
# ===================================
# サーバーが listen するポート
PORT=8080
# ログインを許可するユーザーのメールアドレス（カンマ区切り）
ALLOWED_USER_EMAILS=
# サーバ側でメール/パスワード照合に使う Firebase Web API key（ブラウザには渡さない）
# FIREBASE_WEB_API_KEY が優先され、未設定時は FIREBASE_API_KEY にフォールバックする（どちらか一方でログイン可）。
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_API_KEY=your-firebase-web-api-key
# サーバセッションCookieの署名に使うランダムなシークレット
AUTH_SECRET=your-random-secret-key-here

# ===================================
# GCP / Cloud Run デプロイ設定
# ===================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast1
CLOUD_RUN_SERVICE_NAME=shrine-stair-trainer
ARTIFACT_REGISTRY_REPOSITORY=shrine-stair-registry
IMAGE_NAME=shrine-stair-trainer
