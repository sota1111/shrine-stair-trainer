# 認証パスワード（個人利用向け）
# このファイルを .env にコピーし、任意のパスワードを設定してください
# Cloud Run本番環境ではSecret Manager管理 (secret name: shrine-trainer-auth-password)
VITE_AUTH_PASSWORD=your-password-here

# ===================================
# GCP / Cloud Run デプロイ設定
# ===================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast1
CLOUD_RUN_SERVICE_NAME=shrine-stair-trainer
ARTIFACT_REGISTRY_REPOSITORY=shrine-stair-registry
IMAGE_NAME=shrine-stair-trainer
